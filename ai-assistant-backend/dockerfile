FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -B -ntp -DskipTests dependency:go-offline
COPY src ./src
RUN mvn -B -ntp -DskipTests package && \
    jar="$(find target -maxdepth 1 -type f -name '*.jar' ! -name '*.jar.original' -print -quit)" && \
    test -n "$jar" && cp "$jar" /workspace/app.jar

FROM eclipse-temurin:25-jre-alpine
WORKDIR /app
RUN addgroup -S myapp && adduser -S -G myapp myapp
COPY --from=build --chown=myapp:myapp /workspace/app.jar app.jar
USER myapp:myapp
EXPOSE 8080
ENTRYPOINT ["java","--enable-native-access=ALL-UNNAMED", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]